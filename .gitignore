# Managed Blender install and the resolved path pointing at it
tools/blender-bin/
tools/.blender_path

# Generated assets, reports and previews
assets/out/

# Character Studio: Godot cache. Humans live in assets/humans/; this path is a junction.
character_studio/.godot/
character_studio/assets/humans/

# MPFB user data staged for the Character Studio export
tools/character_studio/.mpfb_user_data/

# Downloaded MakeHuman community/pack clothes (rebuild via fetch_medieval_clothes.py)
tools/character_studio/.mh_download_cache/
tools/character_studio/makehuman_extra_assets/clothes/

# Human library: export the .glb files (wardrobe.json is the committed catalogue)
assets/humans/**
!assets/humans/.gitkeep
!assets/humans/wardrobe.json
!assets/humans/CREDITS.txt
!assets/humans/pieces/
!assets/humans/pieces/.gitkeep

# Quaternius Ultimate Monsters: fetch the .glb files and atlas
assets/monsters/quaternius/**
!assets/monsters/quaternius/.gitkeep
!assets/monsters/quaternius/catalog.json
!assets/monsters/quaternius/CREDITS.txt

# Engine viewer build
/target/

__pycache__/
*.py[cod]
.venv/

# Local human/monster bake scratch and diagnostics
tools/_human_bake/
tools/_human_orc_bake/
tools/_tribal_veteran_bake/
tools/_inspect_human_glb.py
