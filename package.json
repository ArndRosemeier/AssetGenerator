{
  "name": "futuremagic-kit",
  "private": true,
  "type": "module",
  "description": "TypeScript packages shared by the futuremagic games. The Python/Blender pipeline lives alongside in tools/ and blender/.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --import tsx --test \"packages/*/test/*.test.ts\"",
    "test:gpu": "node packages/volume/test/gpu/run.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "@types/node": "^24.0.0",
    "three": "^0.186.1",
    "@types/three": "^0.186.0",
    "@webgpu/types": "^0.1.64"
  }
}
